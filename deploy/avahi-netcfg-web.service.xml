<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  Copy this to /etc/avahi/services/netcfg-web.service so the device advertises
  itself on the LAN. You can then use https://<hostname>.local:8090/ instead of
  remembering an IP address.
  Requires: apt install avahi-daemon
-->
<service-group>
  <name replace-wildcards="yes">Network configuration on %h</name>
  <service>
    <type>_https._tcp</type>
    <port>8090</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
