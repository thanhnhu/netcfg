[Unit]
Description=netcfg-web — network configuration web interface
Documentation=https://netcfg.local/
After=netcfgd.service
Requires=netcfgd.service

[Service]
Type=simple
# -listen :8090 opens the UI to the whole LAN; a self-signed certificate is
# generated on first start. -portal-listen :80 serves the captive portal used
# while the fallback access point is running.
ExecStart=/usr/local/bin/netcfg-web \
    -listen :8090 \
    -portal-listen :80 \
    -portal-url http://192.168.4.1/ \
    -agent-socket /run/netcfgd/netcfgd.sock \
    -config /etc/netcfg-web/config.json \
    -state-dir /var/lib/netcfg-web \
    -log-format json
Restart=on-failure
RestartSec=3

# The entire network facing attack surface runs here, with no privileges.
User=netcfg
Group=netcfg
StateDirectory=netcfg-web
StateDirectoryMode=0700
ConfigurationDirectory=netcfg-web
ConfigurationDirectoryMode=0750

# Exactly one privilege: binding port 80 for the captive portal.
# Drop both lines if you do not use -portal-listen.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
