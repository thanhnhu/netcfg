#!/bin/sh
set -e

# An upgrade must not stop anything: postinst restarts both units once the new
# binaries are in place.
case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            systemctl stop netcfg-web.service netcfgd.service >/dev/null 2>&1 || true
            systemctl disable netcfg-web.service netcfgd.service >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
